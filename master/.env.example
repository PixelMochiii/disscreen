# Copier ce fichier en .env et remplir les valeurs.
# Le .env est ignoré par git — ne JAMAIS commiter ce fichier avec de vraies valeurs.

# Clé de signature des sessions Flask. Générer avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Identifiants SSH pour la gestion des endpoints
# SSH_KEY_USER : utilisateur dédié créé par install.sh sur chaque endpoint
# SSH_PASS_USER / SSH_PASS : fallback si install.sh n'a pas encore été exécuté
SSH_KEY_USER=screenuser
SSH_PASS_USER=YOUR_SESSION_USER
SSH_PASS=YOUR_SSH_PASSWORD

# Mot de passe de l'admin créé au premier démarrage de la DB.
# Sera ignoré si la DB existe déjà. L'utilisateur sera forcé de le changer
# au premier login.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_LOGIN

# IP du master (utilisée par les URL transmises aux endpoints)
MASTER_IP=YOUR_MASTER_IP
